# Roll Call environment
# Local SQLite file (default). For production use Turso/libsql: libsql://<db>.turso.io
DATABASE_URL=file:./data/rollcall.db
DATABASE_AUTH_TOKEN=
# Public origin used in share links and OG cards
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret used to sign nothing yet; reserved for webhook verification
APP_SECRET=change-me
# Email delivery for sign-in codes. Leave empty to log codes to the server console (dev).
# Who may open /founder (comma-separated). In sandbox mode the demo organiser can.
FOUNDER_EMAILS=
RESEND_API_KEY=
EMAIL_FROM=Roll Call <hello@rollcall.club>
# Payments. Leave empty to run the ledger in "manual settle" mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
