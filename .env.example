# Roll Call environment
# Local SQLite file (default). For production use Turso/libsql: libsql://<db>.turso.io
DATABASE_URL=file:./data/rollcall.db
DATABASE_AUTH_TOKEN=
# Public origin used in share links and OG cards
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret used to sign nothing yet; reserved for webhook verification
APP_SECRET=change-me
# Email delivery for sign-in codes. Leave empty to log codes to the server console (dev).
# Who may open /founder (comma-separated). In sandbox mode the demo organiser can.
FOUNDER_EMAILS=
RESEND_API_KEY=
EMAIL_FROM=Roll Call <hello@rollcall.club>
# Payments (Stripe Connect, Express accounts). Leave empty to run the ledger in "mark as paid" mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Roll Call fee on card payments: basis points and fixed pence. Default 250 + 20 = 2.5% + 20p.
PLATFORM_FEE_BPS=250
PLATFORM_FEE_FIXED_PENCE=20
# Reminders: Vercel Cron calls /api/cron/reminders with this as a bearer token.
CRON_SECRET=
# Venue address finder on the session form. Google Places Autocomplete (New) when set; otherwise the
# free OpenStreetMap geocoder (Photon), which needs no key.
GOOGLE_MAPS_API_KEY=
# Golf course cards from golfcourseapi.com (par and stroke index per tee). Without it, search covers
# the cards crews have already entered; organisers can still scan or type a card.
GOLF_COURSE_API_KEY=
# Golf play mode: MapTiler key for the satellite map (free tier, restrict it to your domain). Distances work without it.
MAPTILER_KEY=
# Scorecard scanning: photo of the paper card -> card for the organiser to confirm. Uses the Claude API.
ANTHROPIC_API_KEY=
